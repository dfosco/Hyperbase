{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypercanvas.dev/schemas/canvas-document-v2.json",
  "title": "Hypercanvas persisted canvas JSONL event",
  "description": "Schema for individual persisted JSONL records. A document is an ordered stream beginning with one canvas_created record. The separate canvas creation input schema is canvas.schema.json.",
  "oneOf": [
    { "$ref": "#/$defs/canvasCreated" },
    { "$ref": "#/$defs/widgetAdded" },
    { "$ref": "#/$defs/widgetUpdated" },
    { "$ref": "#/$defs/widgetMoved" },
    { "$ref": "#/$defs/widgetRemoved" },
    { "$ref": "#/$defs/settingsUpdated" },
    { "$ref": "#/$defs/sourceUpdated" },
    { "$ref": "#/$defs/widgetsReplaced" },
    { "$ref": "#/$defs/connectorAdded" },
    { "$ref": "#/$defs/connectorRemoved" },
    { "$ref": "#/$defs/connectorsReplaced" },
    { "$ref": "#/$defs/connectorWaypointsSet" },
    { "$ref": "#/$defs/connectorWaypointsCleared" },
    { "$ref": "#/$defs/connectorUpdated" },
    { "$ref": "#/$defs/canvasLayoutUpdated" },
    { "$ref": "#/$defs/canvasLayoutRestored" },
    { "$ref": "#/$defs/unknownOptionalEvent" }
  ],
  "$defs": {
    "record": { "type": "object", "properties": { "event": { "type": "string" }, "required": { "type": "boolean" } }, "required": ["event"], "additionalProperties": true },
    "widget": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
    "connector": { "type": "object", "required": ["id", "start", "end"], "properties": { "id": { "type": "string", "minLength": 1 }, "start": { "type": "object", "required": ["widgetId"], "properties": { "widgetId": { "type": "string", "minLength": 1 } }, "additionalProperties": true }, "end": { "type": "object", "required": ["widgetId"], "properties": { "widgetId": { "type": "string", "minLength": 1 } }, "additionalProperties": true } }, "additionalProperties": true },
    "position": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "additionalProperties": true },
    "geometry": { "type": "object", "required": ["position", "width", "height"], "properties": { "position": { "$ref": "#/$defs/position" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": true },
    "layoutFieldSnapshot": { "oneOf": [{ "type": "object", "required": ["present"], "properties": { "present": { "const": false } }, "additionalProperties": false }, { "type": "object", "required": ["present", "value"], "properties": { "present": { "const": true }, "value": {} }, "additionalProperties": false }] },
    "layoutSourceSnapshot": { "oneOf": [{ "type": "object", "required": ["present"], "properties": { "present": { "const": false } }, "additionalProperties": false }, { "type": "object", "required": ["present", "position", "width", "height"], "properties": { "present": { "const": true }, "position": { "$ref": "#/$defs/layoutFieldSnapshot" }, "width": { "$ref": "#/$defs/layoutFieldSnapshot" }, "height": { "$ref": "#/$defs/layoutFieldSnapshot" } }, "additionalProperties": false }, { "type": "object", "required": ["present", "index", "record"], "properties": { "present": { "const": true }, "index": { "type": "integer", "minimum": 0 }, "record": { "type": "object", "required": ["export"], "properties": { "export": { "type": "string", "minLength": 1 } }, "additionalProperties": true } }, "additionalProperties": false }] },
    "canvasCreated": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "properties": { "event": { "const": "canvas_created" }, "formatVersion": { "enum": [1, 2] }, "scroll": { "type": "object", "properties": { "axis": { "enum": ["both", "vertical", "horizontal", "none"] } }, "additionalProperties": true }, "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } }, "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } }, "sources": { "type": "array", "items": { "type": "object", "properties": { "export": { "type": "string", "minLength": 1 } }, "additionalProperties": true } } }, "required": ["event"] }] },
    "widgetAdded": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["widget"], "properties": { "event": { "const": "widget_added" }, "widget": { "$ref": "#/$defs/widget" } } }] },
    "widgetUpdated": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["widgetId", "props"], "properties": { "event": { "const": "widget_updated" }, "widgetId": { "type": "string", "minLength": 1 }, "props": { "type": "object" } } }] },
    "widgetMoved": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["widgetId", "position"], "properties": { "event": { "const": "widget_moved" }, "widgetId": { "type": "string", "minLength": 1 }, "position": { "$ref": "#/$defs/position" } } }] },
    "widgetRemoved": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "properties": { "event": { "const": "widget_removed" }, "widgetId": { "type": "string", "minLength": 1 }, "widget": { "$ref": "#/$defs/widget" }, "required": { "type": "boolean" } }, "anyOf": [{ "required": ["widgetId"] }, { "required": ["widget"] }] }] },
    "settingsUpdated": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["settings"], "properties": { "event": { "const": "settings_updated" }, "settings": { "type": "object" } } }] },
    "sourceUpdated": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["sources"], "properties": { "event": { "const": "source_updated" }, "sources": { "type": "array" } } }] },
    "widgetsReplaced": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["widgets"], "properties": { "event": { "const": "widgets_replaced" }, "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } } } }] },
    "connectorAdded": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["connector"], "properties": { "event": { "const": "connector_added" }, "connector": { "$ref": "#/$defs/connector" } } }] },
    "connectorRemoved": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "properties": { "event": { "const": "connector_removed" }, "connectorId": { "type": "string", "minLength": 1 }, "connector": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } }, "additionalProperties": true } }, "anyOf": [{ "required": ["connectorId"] }, { "required": ["connector"] }] }] },
    "connectorsReplaced": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "properties": { "event": { "const": "connectors_replaced" }, "connectors": { "type": ["array", "null"], "items": { "$ref": "#/$defs/connector" } } } }] },
    "connectorWaypointsSet": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["connectorId"], "properties": { "event": { "const": "connector_waypoints_set" }, "connectorId": { "type": "string", "minLength": 1 } } }] },
    "connectorWaypointsCleared": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["connectorId"], "properties": { "event": { "const": "connector_waypoints_cleared" }, "connectorId": { "type": "string", "minLength": 1 } } }] },
    "connectorUpdated": { "allOf": [{ "$ref": "#/$defs/record" }, { "type": "object", "required": ["connectorId"], "properties": { "event": { "const": "connector_updated" }, "connectorId": { "type": "string", "minLength": 1 }, "updates": { "type": ["object", "null"] } } }] },
    "canvasLayoutUpdated": {
      "allOf": [
        { "$ref": "#/$defs/record" },
        {
          "type": "object",
          "required": ["scroll", "widgets", "sources"],
          "properties": {
            "event": { "const": "canvas_layout_updated" },
            "scroll": {
              "type": "object",
              "required": ["axis"],
              "properties": { "axis": { "enum": ["both", "vertical", "horizontal", "none"] } },
              "additionalProperties": true
            },
            "widgets": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/geometry" },
                  { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } }
                ]
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/geometry" },
                  { "type": "object", "required": ["export"], "properties": { "export": { "type": "string", "minLength": 1 } } }
                ]
              }
            }
          }
        }
      ]
    },
    "canvasLayoutRestored": {
      "allOf": [
        { "$ref": "#/$defs/record" },
        {
          "type": "object",
          "required": ["required", "action", "snapshot"],
          "properties": {
            "event": { "const": "canvas_layout_restored" },
            "required": { "const": true },
            "action": { "enum": ["undo", "redo"] },
            "snapshot": {
              "type": "object",
              "required": ["axis", "widgets", "sources", "sourcesContainer"],
              "properties": {
                "axis": { "type": "object", "required": ["expected", "restore"], "properties": { "expected": { "enum": ["both", "vertical", "horizontal", "none"] }, "restore": { "enum": ["both", "vertical", "horizontal", "none"] } }, "additionalProperties": false },
                "widgets": { "type": "array", "items": { "type": "object", "required": ["id", "expected", "restore"], "properties": { "id": { "type": "string", "minLength": 1 }, "expected": { "type": "object", "required": ["position", "width", "height", "propsContainer"], "properties": { "position": { "$ref": "#/$defs/layoutFieldSnapshot" }, "width": { "$ref": "#/$defs/layoutFieldSnapshot" }, "height": { "$ref": "#/$defs/layoutFieldSnapshot" }, "propsContainer": { "enum": ["absent", "null", "object"] } }, "additionalProperties": false }, "restore": { "type": "object", "required": ["position", "width", "height", "propsContainer"], "properties": { "position": { "$ref": "#/$defs/layoutFieldSnapshot" }, "width": { "$ref": "#/$defs/layoutFieldSnapshot" }, "height": { "$ref": "#/$defs/layoutFieldSnapshot" }, "propsContainer": { "enum": ["absent", "null", "object"] } }, "additionalProperties": false } }, "additionalProperties": false } },
                "sources": { "type": "array", "items": { "type": "object", "required": ["export", "expected", "restore"], "properties": { "export": { "type": "string", "minLength": 1 }, "expected": { "$ref": "#/$defs/layoutSourceSnapshot" }, "restore": { "$ref": "#/$defs/layoutSourceSnapshot" } }, "additionalProperties": false } },
                "sourcesContainer": { "type": "object", "required": ["expected", "restore"], "properties": { "expected": { "enum": ["absent", "null", "array"] }, "restore": { "enum": ["absent", "null", "array"] } }, "additionalProperties": false }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "unknownOptionalEvent": {
      "allOf": [
        { "$ref": "#/$defs/record" },
        {
          "not": {
            "properties": {
              "event": {
                "enum": [
                  "canvas_created", "widget_added", "widget_updated", "widget_moved", "widget_removed",
                  "settings_updated", "source_updated", "widgets_replaced", "connector_added",
                  "connector_removed", "connectors_replaced", "connector_waypoints_set",
                  "connector_waypoints_cleared", "connector_updated", "canvas_layout_updated", "canvas_layout_restored"
                ]
              }
            }
          }
        },
        { "properties": { "required": { "not": { "const": true } } } }
      ]
    }
  }
}
